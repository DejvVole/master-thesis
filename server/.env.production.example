# =============================================================
# Server .env pre produkciu
# Skopiruj ako server/.env a uprav hodnoty
# =============================================================

# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=production

# Frontend URL (pouziva sa v auth linkoch, emailoch, trusted origins)
# Nastav na skutocnu URL servera, napr. http://194.62.248.32 alebo http://mojastranka.sk
CLIENT_URL=http://TVOJA_IP_ALEBO_DOMENA

# CORS — rovnaka hodnota ako CLIENT_URL
CORS_ORIGINS=http://TVOJA_IP_ALEBO_DOMENA

# Database (docker network — hostname = nazov service v docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=building_rag
DB_USER=postgres
DB_PASSWORD=ZMEN_NA_SILNE_HESLO
DATABASE_URL=postgres://postgres:ZMEN_NA_SILNE_HESLO@postgres:5432/building_rag

# MinIO (docker network)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=ZMEN_NA_SILNE_MENO
MINIO_SECRET_KEY=ZMEN_NA_SILNE_HESLO
MINIO_BUCKET_RAW=raw-pdfs
MINIO_BUCKET_EXPORTS=rag-exports

# Python pipeline (nastavene v docker-compose, netreba menit)
PYTHON_BIN=/opt/venv/bin/python
BACKEND_DIR=/app/backend

# OpenAI API key (povinne)
OPENAI_API_KEY=sk-...

# Volitelne alternativne LLM
GROQ_API_KEY=
MISTRAL_API_KEY=

# SMTP pre pozvanky (volitelne)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_NAME=Historic Buildings

# Auth secret — vygeneruj nahodny retazec 32+ znakov
# Napr.: openssl rand -base64 32
BETTER_AUTH_SECRET=ZMEN_NA_NAHODNY_SECRET
