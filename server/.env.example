# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# Frontend URL used in auth links and trusted origins
CLIENT_URL=http://localhost:5173

# CORS - comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (inside docker network)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=building_rag
DB_USER=postgres
DB_PASSWORD=rag_password
DATABASE_URL=postgres://postgres:rag_password@postgres:5432/building_rag

# MinIO (inside docker network)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw-pdfs
MINIO_BUCKET_EXPORTS=rag-exports

# Python pipeline location in container
PYTHON_BIN=/opt/venv/bin/python
BACKEND_DIR=/app/backend

# Required API keys
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key_optional
MISTRAL_API_KEY=your_mistral_api_key_optional

# SMTP for invitations (optional if invitations are not used)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_NAME=Historic Buildings

# Better Auth secret (generate random 32+ chars)
BETTER_AUTH_SECRET=replace_with_random_secret
